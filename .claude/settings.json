{
  "permissions": {
    "deny": ["Workflow"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/limit-agents.mjs\"",
            "timeout": 10,
            "statusMessage": "Проверка лимита агентов"
          }
        ]
      }
    ]
  }
}
